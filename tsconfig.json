{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["apps/mobile/src/**/*.ts", "apps/mobile/src/**/*.tsx", "apps/server/src/**/*.ts", "packages/**/*.ts", "tests/**/*.ts", "vitest*.ts"]
}
