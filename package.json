{
  "name": "spot-learn-battle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "content:schemas": "tsx tools/write-content-schemas.ts",
    "content:schemas:check": "tsx tools/write-content-schemas.ts --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude tests/database/**/*.test.ts",
    "content:validate": "tsx packages/content-validator/src/validate-content.ts content/fixtures/valid",
    "db:start": "supabase start",
    "test:db:concurrency": "vitest run --config vitest.db.config.ts --sequence.concurrent=false",
    "check:db": "supabase db reset --local && supabase db lint --local --fail-on error && supabase test db --local && pnpm test:db:concurrency",
    "check": "pnpm content:schemas:check && pnpm typecheck && pnpm test && pnpm content:validate"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "pg": "^8.16.3",
    "smol-toml": "^1.6.0",
    "supabase": "^2.67.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
