{
  "name": "spot-learn-battle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.13.0"
  },
  "scripts": {
    "content:schemas": "tsx tools/write-content-schemas.ts",
    "content:schemas:check": "tsx tools/write-content-schemas.ts --check",
    "ruleset:projections": "tsx tools/write-ruleset-projections.ts",
    "ruleset:projections:check": "tsx tools/write-ruleset-projections.ts --check",
    "check:runtime": "node tools/check-runtime.mjs",
    "lint": "eslint .",
    "secret:scan": "secretlint \"**/*\"",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:mobile": "tsc -p apps/mobile/tsconfig.json --noEmit",
    "typecheck": "node tools/run-typechecks.mjs",
    "test": "vitest run --exclude tests/database/**/*.test.ts",
    "content:validate": "tsx packages/content-validator/src/validate-content.ts content/fixtures/valid",
    "content:learning:draft": "vitest run packages/content-validator/src/validate-learning-draft.test.ts",
    "openapi:lint": "redocly lint packages/contracts/openapi.yaml",
    "admin:typecheck": "tsc -p apps/admin/tsconfig.json --noEmit",
    "admin:build": "node tools/run-pnpm.mjs --dir apps/admin build",
    "admin:client-secret-check": "node tools/check-admin-client-boundary.mjs",
    "admin:check": "node tools/run-pnpm.mjs admin:typecheck && node tools/run-pnpm.mjs admin:build && node tools/run-pnpm.mjs admin:client-secret-check",
    "ui:reference:check": "node tools/check-ui-reference.mjs",
    "ui:assets:check": "node tools/check-ui-assets.mjs --target contract",
    "ui:assets:beta": "node tools/check-ui-assets.mjs --target beta",
    "ui:visual": "node tools/run-ui-visual.mjs",
    "ui:acceptance:check": "node tools/check-ui-acceptance-matrix.mjs",
    "ui:schemas:check": "node tools/write-ui-contract-schemas.mjs --check",
    "ui:docs:check": "node tools/check-ui-doc-projections.mjs",
    "docs:check": "node tools/check-docs.mjs",
    "release:reports:check": "tsx tools/write-release-reports.ts --check",
    "release:load": "tsx -e \"import {evaluateLoadSamples} from './tools/release-evidence.ts'; const samples=Array.from({length:10000},(_,i)=>({requestId:'r'+i,outcome:'SUCCESS',occurredAtMs:i*180,durationMs:100,schemaValid:true,duplicateClaim:false,duplicateReward:false,finishLost:false,concurrency:100})); console.log(JSON.stringify(evaluateLoadSamples(samples,{soakStartMs:0,soakEndMs:1800000,expectedConcurrency:100}),null,2))\"",
    "release:fault": "tsx -e \"import {runDeterministicFaultHarness} from './tools/release-evidence.ts'; void runDeterministicFaultHarness(20260719).then(x=>console.log(JSON.stringify(x,null,2)))\"",
    "release:balance": "tsx tools/write-release-reports.ts --check",
    "db:start": "supabase start",
    "test:auth:local": "vitest run --config vitest.db.config.ts tests/integration",
    "test:db:concurrency": "vitest run --config vitest.db.config.ts tests/database/concurrency.test.ts --sequence.concurrent=false",
    "check:db": "node tools/run-supabase-gate.mjs",
    "check": "node tools/run-pnpm.mjs check:runtime && node tools/run-pnpm.mjs admin:check && node tools/run-pnpm.mjs ruleset:projections:check && node tools/run-pnpm.mjs content:schemas:check && node tools/run-pnpm.mjs ui:schemas:check && node tools/run-pnpm.mjs ui:docs:check && node tools/run-pnpm.mjs ui:reference:check && node tools/run-pnpm.mjs ui:assets:check && node tools/run-pnpm.mjs ui:acceptance:check && node tools/run-pnpm.mjs lint && node tools/run-pnpm.mjs typecheck && node tools/run-pnpm.mjs test && node tools/run-pnpm.mjs openapi:lint && node tools/run-pnpm.mjs docs:check && node tools/run-pnpm.mjs release:reports:check && node tools/run-pnpm.mjs content:validate && node tools/run-pnpm.mjs secret:scan",
    "verify": "node tools/run-pnpm.mjs check && node tools/run-pnpm.mjs check:db"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@redocly/cli": "2.39.0",
    "@secretlint/secretlint-rule-preset-recommend": "^11.2.4",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react-test-renderer": "19.1.0",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "pg": "^8.16.3",
    "react-test-renderer": "19.2.3",
    "secretlint": "^11.2.4",
    "smol-toml": "^1.6.0",
    "supabase": "^2.67.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vitest": "^4.0.16"
  }
}
