node_modules/
.pnpm-store/
.worktrees/
.superpowers/
.env
.env.*
!.env.example
!.env.*.example
apps/*/.env
apps/*/.env.*
!apps/*/.env.example
# Every `*.example` is a template with empty values, not a secret. The negation above only
# rescued the exact name `.env.example`, so `.env.privacy-worker.example` was ignored -- and
# the worker runbook told operators to copy a file a fresh clone would not have.
!apps/*/.env.*.example
apps/*/.expo/
apps/admin/.next*/
supabase/.temp/
supabase/.branches/
artifacts/
coverage/

# OAuth client credential downloads. The Google console hands these out as
# client_secret_<id>.apps.googleusercontent.com.json, and they land in whatever folder the
# browser saves to — which is how a client secret ends up one `git add .` away from a commit.
client_secret_*.json

# Local agent and editor state. These belong to whoever is sitting at the machine,
# not to the repository. `CLAUDE.md` is the exception and is tracked on purpose.
.serena/
.grok/
.obsidian/
.expo/

# Build scratch. `apps/admin/.next*/` above catches the directory but not these two.
tsconfig.tsbuildinfo
apps/admin/.next-build-active.json

# Metro and Expo write their logs wherever they were launched from, which is usually
# the repo root. No log file is tracked here, so the blanket pattern is safe.
*.log

# Android signing material. The upload key is the one secret that cannot be rotated after the
# app ships — Play App Signing accepts uploads signed by it and nothing else — so it never
# enters this repository, not even in a branch that is "not going to be pushed".
# `apps/mobile/android/app/debug.keystore` is tracked on purpose and stays exempt: it signs
# debug builds only, and the release build refuses to fall back to it.
*.jks
*.keystore
*.p12
*.pem
!apps/mobile/android/app/debug.keystore
