{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://touchcatch.invalid/content/pets/source-manifest.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "admissions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "admissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceSha256", "normalizedSlug", "candidateRarity", "familySlug", "rightsStatus", "provenanceNote", "visualReview", "backgroundReview", "cropReview", "coachArchetype", "fileName", "width", "height", "pixelFormat"],
        "properties": {
          "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "normalizedSlug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "candidateRarity": { "enum": ["COMMON", "UNCOMMON", "RARE", "EPIC", "LEGENDARY"] },
          "familySlug": { "type": ["string", "null"] },
          "rightsStatus": { "enum": ["PENDING", "APPROVED", "REJECTED"] },
          "provenanceNote": { "type": "string", "minLength": 1 },
          "visualReview": { "enum": ["PENDING", "APPROVED", "REDRAW_REQUIRED", "REJECTED"] },
          "backgroundReview": { "enum": ["PENDING", "APPROVED", "REMOVE_REQUIRED"] },
          "cropReview": { "enum": ["PENDING", "APPROVED", "REWORK_REQUIRED"] },
          "coachArchetype": { "enum": ["SCOUT", "LINGUIST", "SAGE", "CHEER"] },
          "fileName": { "type": "string", "minLength": 1 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "pixelFormat": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
