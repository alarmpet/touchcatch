{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"UiRuntimeAssetManifestV1",
  "oneOf":[{"$ref":"#/$defs/draft"},{"$ref":"#/$defs/approved"}],
  "$defs":{
    "review":{"type":"object","additionalProperties":false,"required":["reviewId","version","artifactHash","status","reviewedBy","reviewedAt"],"properties":{"reviewId":{"type":"string","minLength":1},"version":{"const":"1.0.0"},"artifactHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"status":{"const":"APPROVED"},"reviewedBy":{"type":"string","minLength":1},"reviewedAt":{"type":"string","format":"date-time"}}},
    "entry":{"type":"object","additionalProperties":false,"required":["assetId","assetClass","file","url","sha256","encodedBytes","width","height","mimeType","containsBakedUiText","textReview","usage","provenance","rights","themeReview","modelReview","visualReview","classReview"],"properties":{
      "assetId":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{0,127}$"},"assetClass":{"enum":["icons","illustrations","background-patterns","logos","fonts"]},"file":{"type":"string","pattern":"^(icons|illustrations|background-patterns|logos|fonts)/[a-z0-9._-]+$"},"url":{"type":"string","pattern":"^https://[^?#]+/assets/[a-f0-9]{64}\\.(png|webp|woff2)$"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"encodedBytes":{"type":"integer","minimum":1,"maximum":8388608},"width":{"type":["integer","null"],"minimum":1,"maximum":4096},"height":{"type":["integer","null"],"minimum":1,"maximum":4096},"mimeType":{"enum":["image/png","image/webp","font/woff2"]},"containsBakedUiText":{"const":false},"textReview":{"$ref":"#/$defs/review"},
      "usage":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["screenId","componentId"],"properties":{"screenId":{"enum":["HOME_DEFAULT","MATCH_WORD_HUNT","MATCH_MEANING_SUCCESS","PET_COLLECTION"]},"componentId":{"type":"string","minLength":1,"maxLength":128}}}},
      "provenance":{"type":"object","additionalProperties":false,"required":["generator","model","modelVersion","termsUrl","promptHash","generatedAt"],"properties":{"generator":{"type":"string","minLength":1},"model":{"type":"string","minLength":1},"modelVersion":{"type":"string","minLength":1},"termsUrl":{"type":"string","format":"uri"},"promptHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"generatedAt":{"type":"string","format":"date-time"}}},
      "rights":{"type":"object","additionalProperties":false,"required":["rightsRecordId","licenseId","permissionEvidenceId","assetSha256","approvedBy","approvedAt"],"properties":{"rightsRecordId":{"type":"string","minLength":1},"licenseId":{"type":"string","minLength":1},"permissionEvidenceId":{"type":"string","minLength":1},"assetSha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"approvedBy":{"type":"string","minLength":1},"approvedAt":{"type":"string","format":"date-time"}}},
      "themeReview":{"$ref":"#/$defs/review"},"modelReview":{"$ref":"#/$defs/review"},"visualReview":{"$ref":"#/$defs/review"},
      "classReview":{"type":"object","additionalProperties":false,"properties":{"characterModelSheetId":{"type":"string","minLength":1},"paletteApproved":{"const":true},"outlineApproved":{"const":true},"proportionApproved":{"const":true},"iconStyleApproved":{"const":true},"redistributionLicenseId":{"type":"string","minLength":1},"supportedWeightRange":{"type":"array","minItems":2,"maxItems":2,"prefixItems":[{"type":"integer","minimum":1},{"type":"integer","minimum":1,"maximum":1000}],"items":false}},"required":[]}
    },"allOf":[
      {"if":{"properties":{"assetClass":{"const":"illustrations"}}},"then":{"properties":{"classReview":{"type":"object","properties":{"characterModelSheetId":{},"paletteApproved":{},"outlineApproved":{},"proportionApproved":{}},"required":["characterModelSheetId","paletteApproved","outlineApproved","proportionApproved"]}}}},
      {"if":{"properties":{"assetClass":{"const":"icons"}}},"then":{"properties":{"classReview":{"type":"object","properties":{"paletteApproved":{},"outlineApproved":{},"iconStyleApproved":{}},"required":["paletteApproved","outlineApproved","iconStyleApproved"]}}}},
      {"if":{"properties":{"assetClass":{"const":"fonts"}}},"then":{"properties":{"classReview":{"type":"object","properties":{"redistributionLicenseId":{},"supportedWeightRange":{}},"required":["redistributionLicenseId","supportedWeightRange"]}}}}
    ]},
    "draft":{"type":"object","additionalProperties":false,"required":["schemaVersion","lifecycle","approvalDecisionId","approvedBy","approvedAt","entries","buildReferences"],"properties":{"schemaVersion":{"const":"1.0.0"},"lifecycle":{"const":"DRAFT"},"approvalDecisionId":{"type":"null"},"approvedBy":{"type":"null"},"approvedAt":{"type":"null"},"entries":{"type":"array","maxItems":0},"buildReferences":{"type":"array","maxItems":0}}},
    "approved":{"type":"object","additionalProperties":false,"required":["schemaVersion","lifecycle","approvalDecisionId","approvedBy","approvedAt","entries","buildReferences"],"properties":{"schemaVersion":{"const":"1.0.0"},"lifecycle":{"const":"APPROVED"},"approvalDecisionId":{"type":"string","minLength":1},"approvedBy":{"type":"string","minLength":1},"approvedAt":{"type":"string","format":"date-time"},"entries":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/entry"}},"buildReferences":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["assetId","file"],"properties":{"assetId":{"type":"string","minLength":1},"file":{"type":"string","minLength":1}}}}}}
  }
}
