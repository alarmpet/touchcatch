{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://touchcatch.invalid/schemas/daily-pet-loop.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyRevision",
    "status",
    "timezone",
    "dailyDraw",
    "duplicatePromotion",
    "showcase"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyRevision": { "const": "daily-pet-loop-v1" },
    "status": { "enum": ["DRAFT", "APPROVED"] },
    "approvalDecisionId": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "approvedBy": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "approvedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "timezone": { "const": "Asia/Seoul" },
    "dailyDraw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seriesId",
        "businessKey",
        "maxClaimsPerKstDate",
        "accumulates",
        "usesDirectDrawPity",
        "probabilities"
      ],
      "properties": {
        "seriesId": { "const": "DAILY_FREE_DRAW_V1" },
        "businessKey": {
          "type": "array",
          "prefixItems": [
            { "const": "subjectKey" },
            { "const": "kstClaimDate" },
            { "const": "seriesId" }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "maxClaimsPerKstDate": { "const": 1 },
        "accumulates": { "const": false },
        "usesDirectDrawPity": { "const": false },
        "probabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["COMMON", "RARE", "LEGENDARY"],
          "properties": {
            "COMMON": { "const": 0.8 },
            "RARE": { "const": 0.18 },
            "LEGENDARY": { "const": 0.02 }
          }
        }
      }
    },
    "duplicatePromotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seriesId",
        "ownedCopiesRequired",
        "spareCopiesConsumed",
        "retainBaseCopies",
        "transitions",
        "legendaryOutcome"
      ],
      "properties": {
        "seriesId": { "const": "DAILY_PET_PROMOTION_V1" },
        "ownedCopiesRequired": { "const": 11 },
        "spareCopiesConsumed": { "const": 10 },
        "retainBaseCopies": { "const": 1 },
        "transitions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["COMMON", "RARE"],
          "properties": {
            "COMMON": { "const": "RARE" },
            "RARE": { "const": "LEGENDARY" }
          }
        },
        "legendaryOutcome": { "const": "COSMETIC_REWARD_POLICY_REQUIRED" }
      }
    },
    "showcase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxFavoritePets", "rejectUnknownFields"],
      "properties": {
        "maxFavoritePets": { "const": 3 },
        "rejectUnknownFields": { "const": true }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "APPROVED" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "approvalDecisionId": true,
          "approvedBy": true,
          "approvedAt": true
        },
        "required": ["approvalDecisionId", "approvedBy", "approvedAt"]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "properties": { "approvalDecisionId": true },
              "required": ["approvalDecisionId"]
            },
            {
              "properties": { "approvedBy": true },
              "required": ["approvedBy"]
            },
            {
              "properties": { "approvedAt": true },
              "required": ["approvedAt"]
            }
          ]
        }
      }
    }
  ]
}
