{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://touchcatch.invalid/schemas/economy.v1.json",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","economyVersion","status","catalogRevision","catalogHash","pitySeriesId","pitySemantics","pitySemanticsHash","draw","fusion","exp","simulationPolicy","rewardPolicies"],
  "properties":{
    "schemaVersion":{"const":1},"economyVersion":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"status":{"enum":["DRAFT","APPROVED"]},
    "catalogRevision":{"type":"string","minLength":1},"catalogHash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"pitySeriesId":{"type":"string","minLength":1},
    "pitySemantics":{"type":"object","additionalProperties":false,"required":["thresholds","counterIncrementTiming","counterIncrementSources","hardPityOverlapPrecedence","transformAlgorithmVersion","rareOverrideRule","legendaryOverrideRule","rareResetRule","legendaryResetRule","fusionAffectsPity","eligibleResultSemantics"],"properties":{"thresholds":{"type":"object","additionalProperties":false,"required":["rareOrBetter","legendary"],"properties":{"rareOrBetter":{"const":50},"legendary":{"const":150}}},"counterIncrementTiming":{"const":"BEFORE_DRAW"},"counterIncrementSources":{"type":"array","prefixItems":[{"const":"DIRECT_DRAW"}],"items":false,"minItems":1,"maxItems":1},"hardPityOverlapPrecedence":{"const":"LEGENDARY"},"transformAlgorithmVersion":{"const":"simulation-policy-v0"},"rareOverrideRule":{"const":"COMMON_TO_RARE"},"legendaryOverrideRule":{"const":"ALWAYS_LEGENDARY"},"rareResetRule":{"const":"RARE_OR_BETTER"},"legendaryResetRule":{"const":"LEGENDARY_RESETS_BOTH"},"fusionAffectsPity":{"const":false},"eligibleResultSemantics":{"const":"UNIFORM_WITHIN_RARITY"}}},
    "pitySemanticsHash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "draw":{"type":"object","additionalProperties":false,"required":["cost","probabilities"],"properties":{"cost":{"const":100},"probabilities":{"type":"object","additionalProperties":false,"required":["COMMON","RARE","LEGENDARY"],"properties":{"COMMON":{"const":0.8},"RARE":{"const":0.18},"LEGENDARY":{"const":0.02}}}}},
    "fusion":{"type":"object","additionalProperties":false,"required":["materialCount","excludeSelected","excludeLocked"],"properties":{"materialCount":{"const":5},"excludeSelected":{"const":true},"excludeLocked":{"const":true}}},
    "exp":{"type":"object","additionalProperties":false,"required":["win","loss","perfectWordMeaning"],"properties":{"win":{"const":100},"loss":{"const":60},"perfectWordMeaning":{"const":40}}},
    "simulationPolicy":{"const":"simulation-policy-v0"},"rewardPolicies":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},
    "approvalDecisionId":{"type":"string","minLength":1},"approvedBy":{"type":"string","minLength":1},"approvedAt":{"type":"string","format":"date-time"}
  },
  "if":{"properties":{"status":{"const":"APPROVED"}},"required":["status"]},"then":{"properties":{"approvalDecisionId":{"type":"string","minLength":1},"approvedBy":{"type":"string","minLength":1},"approvedAt":{"type":"string","format":"date-time"}},"required":["approvalDecisionId","approvedBy","approvedAt"]}
}
