{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"UiVisualAdaptersV1","type":"object","additionalProperties":false,"required":["schemaVersion","adapters"],"properties":{"schemaVersion":{"const":"1.0.0"},"adapters":{"type":"object","additionalProperties":false,"required":["ios","android"],"properties":{"ios":{"$ref":"#/$defs/adapter"},"android":{"$ref":"#/$defs/adapter"}}}},"$defs":{"adapter":{"type":"object","additionalProperties":false,"required":["id","os","device","runner","command"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9-]+@[1-9][0-9]*$"},"os":{"type":"string","minLength":1},"device":{"type":"string","minLength":1},"runner":{"type":"string","minLength":1},"gpu":{"type":"string","minLength":1},"command":{"type":"array","minItems":2,"items":{"type":"string","minLength":1,"pattern":"^[^\\u0000]+$"}}}}}}
