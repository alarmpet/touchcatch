{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"experiment-contract.v1","type":"object","additionalProperties":false,
  "required":["schemaVersion","experimentId","assignmentUnit","assignmentSaltVersion","variants","allocationBasisPoints","primaryMetric","mde","alpha","power","minSamplePerVariant","guardrails","stoppingRule","cellBucket"],
  "properties":{"schemaVersion":{"const":1},"experimentId":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_-]{2,63}$"},"assignmentUnit":{"const":"anonymousUserId"},"assignmentSaltVersion":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_-]{2,63}$"},"variants":{"const":["CONTROL","TREATMENT"]},"allocationBasisPoints":{"type":"array","prefixItems":[{"type":"integer","minimum":0},{"type":"integer","minimum":0}],"items":false},"primaryMetric":{"const":"final_attempt_rate"},"mde":{"type":"number","exclusiveMinimum":0,"exclusiveMaximum":1},"alpha":{"type":"number","exclusiveMinimum":0,"exclusiveMaximum":1},"power":{"type":"number","exclusiveMinimum":0,"exclusiveMaximum":1},"minSamplePerVariant":{"type":"integer","minimum":1},"guardrails":{"const":["tap_result_p95","unexpected_failure_rate","srm"]},"stoppingRule":{"const":"FIXED_HORIZON"},"cellBucket":{"type":"string","pattern":"^[0-9]{2}:[0-9]{2}$"}}
}
