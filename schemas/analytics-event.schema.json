{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"analytics-event.schema.json","title":"AnalyticsEventV1","type":"object","additionalProperties":false,
  "required":["eventVersion","eventSeq","stateRevision","occurredAt","matchId","anonymousUserId","traceId","engineVersion","rulesetVersion","contentRevisionId","experimentVariant","serverVersion","protocolVersion","name","data"],
  "properties":{"eventVersion":{"const":1},"eventSeq":{"type":"integer","minimum":0},"stateRevision":{"type":"integer","minimum":0},"occurredAt":{"type":"string","format":"date-time"},"matchId":{"type":"string","minLength":1,"maxLength":128},"anonymousUserId":{"type":"string","minLength":1,"maxLength":128},"traceId":{"type":"string","minLength":1,"maxLength":128},"engineVersion":{"type":"string","minLength":1,"maxLength":128},"rulesetVersion":{"type":"string","minLength":1,"maxLength":128},"contentRevisionId":{"type":"string","minLength":1,"maxLength":128},"experimentVariant":{"enum":["CONTROL","TREATMENT"]},"serverVersion":{"type":"string","minLength":1,"maxLength":128},"protocolVersion":{"const":1},"name":{"enum":["same_coordinate_burst_signal","answer_reaction_time_signal","match_stage"]},"data":{"type":"object"}},
  "allOf":[
    {"if":{"properties":{"name":{"const":"same_coordinate_burst_signal"}}},"then":{"properties":{"data":{"type":"object","additionalProperties":false,"required":["cellBucket","countBucket","windowDurationBucket"],"properties":{"cellBucket":{"pattern":"^[0-9]{2}:[0-9]{2}$"},"countBucket":{"enum":["1","2-3","4-7","8-15","16+"]},"windowDurationBucket":{"enum":["<1s","1-2s","2-5s","5s+"]}}}}}},
    {"if":{"properties":{"name":{"const":"answer_reaction_time_signal"}}},"then":{"properties":{"data":{"type":"object","additionalProperties":false,"required":["durationBucket"],"properties":{"durationBucket":{"enum":["<250ms","250-499ms","500-999ms","1-2s","2s+"]}}}}}},
    {"if":{"properties":{"name":{"const":"match_stage"}}},"then":{"properties":{"data":{"type":"object","additionalProperties":false,"required":["stage"],"properties":{"stage":{"enum":["queue","handshake","preload","command","finish","reward"]}}}}}}
  ]
}
