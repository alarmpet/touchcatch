# Account-deletion worker. A separate process with separate credentials from the API.
#
# Do not copy the API's .env into this file. The worker refuses to start if DATABASE_URL or
# SUPABASE_SECRET_KEY are present, because a worker holding the API's login would run as
# economy_server and undo the role split that makes a 202 honest.

# A login that is a member of `privacy_worker` and of nothing else. The API's login must not be
# a member of it, and this one must not be a member of economy_server.
PRIVACY_WORKER_DATABASE_URL=

# HTTPS in every environment except a loopback stack on a developer's own machine.
PRIVACY_WORKER_SUPABASE_URL=

# Service-role key. This deletes auth users, sessions and identities -- the strongest credential
# in the system. It belongs to this process and nowhere else, and never to the API.
PRIVACY_WORKER_SERVICE_ROLE_KEY=

# How long a claimed request stays leased. Long enough for one external call, short enough that a
# crashed worker's requests come back quickly. Default 60.
PRIVACY_WORKER_LEASE_SECONDS=60

# Pause between ticks when there is nothing to do. A tick that advanced a request does not wait.
PRIVACY_WORKER_POLL_MS=5000
