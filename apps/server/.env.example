SUPABASE_URL=
DATABASE_URL=
MOBILE_API_HOST=127.0.0.1
MOBILE_API_PORT=8787
MOBILE_API_ALLOWED_ORIGINS=
# SHA-256 pin for config/trusted-approval-signers.v1.json. Optional locally: the server
# hashes the committed registry when this is empty. Set it in staging/production.
PET_APPROVAL_SIGNER_REGISTRY_SHA256=68be9fefe601be21556a3bf443961abe6884685a3ce47b8d98dcf8ada6bf5984
# Optional for the Android casual-beta HTTP API. Required only by the planned PvP+telemetry stack.
# Production rejects loopback values when these are set.
REDIS_URL=
SENTRY_DSN=
# Production also requires a non-loopback MOBILE_API_HOST and a non-empty origin allow-list.
