{
  "name": "@spot-learn/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:pinned": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../tools/mobile/run-expo-pinned.ps1 start --lan",
    "start:lan": "expo start --lan",
    "web": "expo start --web",
    "web:lan": "expo start --web --lan",
    "typecheck": "tsc --noEmit",
    "web:build": "expo export --platform web --output-dir ../../.superpowers/artifacts/mobile-web-smoke --clear",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.9",
    "@spot-learn/contracts": "workspace:*",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~57.0.12",
    "expo-crypto": "~57.0.1",
    "expo-router": "~57.0.12",
    "expo-screen-orientation": "~57.0.1",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1"
  }
}
